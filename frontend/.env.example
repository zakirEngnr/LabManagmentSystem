# Frontend is static HTML/CSS/JS with no build step, so there are
# no runtime secrets to configure. The only optional setting is the
# API base URL, read by assets/js/api.js.
#
# By default the frontend talks to the API at http://localhost:5000.
# To point it elsewhere, define window.APP_CONFIG before api.js loads, e.g.
# in a small config.js or inline in each page:
#   window.APP_CONFIG = { apiBase: "https://lab.example.com/api" };
# Set the matching CORS_ORIGINS on the backend for that origin.
