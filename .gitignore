# Dependencies
node_modules/

# Secrets — never commit (backend/.gitignore also covers backend/.env)
.env
.env.*
!.env.example

# SQLite databases + WAL sidecars (anywhere in the repo)
*.db
*.db-journal
*.db-wal
*.db-shm

# Backups must never be committed
backups/
*.backup.db

# Logs
*.log
npm-debug.log*

# Runtime / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
