{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "description": "Arham Diagnostic Laboratory — lab management API",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.1.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "test": "node --test tests/",
    "test:smoke": "node scripts/smoke-e2e.js",
    "test:concurrency": "node scripts/repro-concurrency.js 150",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
